  "speech": {
    "CLAIRE-INITIAL": {
      "id": "CLAIRE-INITIAL",
      "name": "Claire",
      "subtitle_en": "I heard two voices. One man was speaking English. The other sounded German to me. It was a harsh, restless voice, much harder to follow. I couldn’t tell what they were arguing about.",
      "language_code": "fr",
      "trigger": "first_encounter"
    },
    "CLAIRE-GERMAN": {
      "id": "CLAIRE-GERMAN",
      "name": "Claire",
      "subtitle_en": "No. It reminded me of a German visitor I once overheard. That was why I thought of German.",
      "language_code": "fr",
      "trigger": "Do you speak German?"
    },
    "CLAIRE-WORDS": {
      "id": "CLAIRE-WORDS",
      "name": "Claire",
      "subtitle_en": "No, not a single word. I remember the sound, but I can’t tell you what it meant.",
      "language_code": "fr",
      "trigger": "Can you repeat any words from that second voice?"
    },
    "CLAIRE-FRENCH": {
      "id": "CLAIRE-FRENCH",
      "name": "Claire",
      "subtitle_en": "I speak French. Nothing I heard sounded like French to me.",
      "language_code": "fr",
      "trigger": "Could it have been French?"
    },
    "MARTIN-INITIAL": {
      "id": "MARTIN-INITIAL",
      "name": "Martin",
      "subtitle_en": "There was a man speaking English, and another voice mixed in with his. I thought the second person was Italian. The sounds came in quick, uneven bursts. Sometimes the two voices overlapped.",
      "language_code": "de",
      "trigger": "first_encounter"
    },
    "MARTIN-GERMAN": {
      "id": "MARTIN-GERMAN",
      "name": "Martin",
      "subtitle_en": "German is my first language. I didn’t recognize any German words in that voice. That isn’t how I would have described it.",
      "language_code": "de",
      "trigger": "Another witness thought it was German."
    },
    "MARTIN-ITALIAN": {
      "id": "MARTIN-ITALIAN",
      "name": "Martin",
      "subtitle_en": "No. I’ve heard it spoken, but I can’t understand it. Italian was my impression, not something I could translate.",
      "language_code": "de",
      "trigger": "Do you speak Italian?"
    },
    "MARTIN-WORDS": {
      "id": "MARTIN-WORDS",
      "name": "Martin",
      "subtitle_en": "From the second voice? No. I couldn’t separate it into words.",
      "language_code": "de",
      "trigger": "Did you hear a complete sentence?"
    },
    "ELENA-INITIAL": {
      "id": "ELENA-INITIAL",
      "name": "Elena",
      "subtitle_en": "I could make out that one man was speaking English. The other voice sounded French to me. It rose suddenly, then broke off, then started again. I remember thinking that someone was terribly upset.",
      "language_code": "it",
      "trigger": "first_encounter"
    },
    "ELENA-ITALIAN": {
      "id": "ELENA-ITALIAN",
      "name": "Elena",
      "subtitle_en": "I’m Italian. I didn’t hear anything I could recognize as Italian.",
      "language_code": "it",
      "trigger": "Another witness thought it was Italian."
    },
    "ELENA-UPSET": {
      "id": "ELENA-UPSET",
      "name": "Elena",
      "subtitle_en": "The sound of the voice. I didn’t understand any words. That was how I interpreted it.",
      "language_code": "it",
      "trigger": "What made you think the person was upset?"
    },
    "ELENA-FRENCH-R2": {
      "id": "ELENA-FRENCH-R2",
      "name": "Elena",
      "subtitle_en": "A little. I can follow an ordinary conversation in French, but I'm not fluent. That voice reminded me of French visitors here, though I couldn't make out a single word. I may have been mistaken.",
      "language_code": "it",
      "trigger": "Do you speak French?"
    },
    "DLG-02-EN-R3": {
      "id": "DLG-02-EN-R3",
      "name": "Claire",
      "subtitle_en": "Such a shame about Jake. I still can't believe he's gone.",
      "language_code": "en",
      "trigger": "passing_conversation"
    },
    "DLG-05-EN-R3": {
      "id": "DLG-05-EN-R3",
      "name": "Elena",
      "subtitle_en": "Yes. Come with me?",
      "language_code": "en",
      "trigger": "passing_conversation"
    },
    "DLG-01-EN-R4": {
      "id": "DLG-01-EN-R4",
      "name": "Martin",
      "subtitle_en": "The recorder is upstairs. Follow the stairs beyond the lounge.",
      "language_code": "en",
      "trigger": "directions"
    },
    "DLG-03-EN-R4": {
      "id": "DLG-03-EN-R4",
      "name": "Elena",
      "subtitle_en": "He was the only zoologist in town. My son wanted to ask him so many questions.",
      "language_code": "en",
      "trigger": "passing_conversation"
    },
    "DLG-04-EN-R4": {
      "id": "DLG-04-EN-R4",
      "name": "Claire",
      "subtitle_en": "Are you still going to the flower shop?",
      "language_code": "en",
      "trigger": "passing_conversation"
    },
    "DLG-06": {
      "id": "DLG-06",
      "name": "Cleaner",
      "subtitle_en": "The recorder? It's in the room at the end of this hall. Watch out for the cart.",
      "language_code": "en",
      "trigger": "directions"
    }
  },
